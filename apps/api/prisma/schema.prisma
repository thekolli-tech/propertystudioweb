generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  DISABLED
  PENDING_VERIFICATION
}

enum OrganizationType {
  DEVELOPER
  AGENCY
}

enum OrganizationStatus {
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  DEVELOPER
  DEVELOPER_STAFF
  AGENT
  AGENT_STAFF
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  PROPERTY_ADMIN
  CONTENT_EDITOR
  MODERATOR
}

enum Persona {
  PROPERTY_SEEKER
  INVESTOR
  PROPERTY_OWNER
  LAND_OWNER
  BUILDER
  LEGAL_VERIFIER
  VALUATION_EXPERT
}

enum ProfileStatus {
  ACTIVE
  DISABLED
}

enum AgencyVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  PLOTTED
  OTHER
}

enum ProjectLifecycleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PropertyType {
  APARTMENT
  VILLA
  PLOT
  OFFICE
  SHOP
  WAREHOUSE
  OTHER
}

enum ListingType {
  SALE
  RENT
}

enum PropertyConfiguration {
  STUDIO
  ONE_BHK
  TWO_BHK
  THREE_BHK
  FOUR_BHK
  FIVE_BHK_PLUS
  OTHER
}

enum PropertyPublicationStatus {
  DRAFT
  PUBLISHED
}

enum PropertyAvailabilityStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
  UNAVAILABLE
}

enum CommunityStatus {
  ACTIVE
  DISABLED
}

enum CommunityVisibility {
  PRIVATE
  PUBLIC
}

enum CatalogEntityType {
  PROJECT
  PROPERTY
  COMMUNITY
}

enum MediaType {
  IMAGE
  VIDEO
  FLOOR_PLAN
  OTHER
}

enum AssetVisibility {
  PRIVATE
  PUBLIC
}

enum ResourceAssignmentType {
  PROPERTY
  PROJECT
}

enum RequirementTransactionType {
  BUY
  RENT
}

enum RequirementStatus {
  DRAFT
  ACTIVE
  PAUSED
  FULFILLED
  CLOSED
  CANCELLED
}

enum RequirementVisibility {
  PRIVATE
  MARKETPLACE
}

enum RequirementPurpose {
  END_USE
  INVESTMENT
  BOTH
}

enum RequirementTimeline {
  IMMEDIATE
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  WITHIN_1_YEAR
  FLEXIBLE
}

enum LeadStatus {
  NEW
  ASSIGNED
  VIEWED
  CONTACTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  BOOKED
  CLOSED
  LOST
}

enum LeadSource {
  REQUIREMENT_MARKETPLACE
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
}

model User {
  id              String        @id @db.Uuid
  publicId        String        @unique @map("public_id") @db.VarChar(32)
  email           String        @unique @db.Citext
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  status          AccountStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?       @map("created_by") @db.Uuid
  updatedBy       String?       @map("updated_by") @db.Uuid

  credential   UserCredential?
  sessions     Session[]
  refreshTokens RefreshToken[]
  platformRoles UserPlatformRole[]
  personas     UserPersona[]
  memberships  OrganizationMembership[]
  requirements Requirement[]
  assignedLeads Lead[] @relation("LeadAssignee")

  @@map("users")
}

model UserCredential {
  id           String   @id @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Session {
  id                     String    @id @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  tokenHash              String    @unique @map("token_hash") @db.VarChar(64)
  activeOrganizationId   String?   @map("active_organization_id") @db.Uuid
  ipAddress              String?   @map("ip_address") @db.VarChar(64)
  userAgent              String?   @map("user_agent") @db.VarChar(512)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64)
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Organization {
  id        String             @id @db.Uuid
  publicId  String             @unique @map("public_id") @db.VarChar(32)
  type      OrganizationType
  name      String             @db.VarChar(120)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?            @map("created_by") @db.Uuid
  updatedBy String?            @map("updated_by") @db.Uuid

  memberships         OrganizationMembership[]
  sessions            Session[]
  developerProfile    DeveloperProfile?
  agencyProfile       AgencyProfile?
  projects            Project[]
  properties          Property[]
  communities         Community[]
  mediaAssets         MediaAsset[]
  documentAssets      DocumentAsset[]
  resourceAssignments ResourceAssignment[]
  leads               Lead[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?          @map("created_by") @db.Uuid
  updatedBy      String?          @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model DeveloperProfile {
  id                 String        @id @db.Uuid
  organizationId     String        @unique @map("organization_id") @db.Uuid
  publicId           String        @unique @map("public_id") @db.VarChar(32)
  legalName          String        @map("legal_name") @db.VarChar(160)
  displayName        String        @map("display_name") @db.VarChar(120)
  description        String?       @db.VarChar(2000)
  logoObjectKey      String?       @map("logo_object_key") @db.VarChar(512)
  website            String?       @db.VarChar(320)
  contactEmail       String?       @map("contact_email") @db.Citext
  contactPhone       String?       @map("contact_phone") @db.VarChar(32)
  headquartersCity   String?       @map("headquarters_city") @db.VarChar(80)
  headquartersState  String?       @map("headquarters_state") @db.VarChar(80)
  operatingZones     String[]      @default([]) @map("operating_zones")
  status             ProfileStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?       @map("created_by") @db.Uuid
  updatedBy          String?       @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("developer_profiles")
}

model AgencyProfile {
  id                   String                   @id @db.Uuid
  organizationId       String                   @unique @map("organization_id") @db.Uuid
  publicId             String                   @unique @map("public_id") @db.VarChar(32)
  legalName            String                   @map("legal_name") @db.VarChar(160)
  displayName          String                   @map("display_name") @db.VarChar(120)
  description          String?                  @db.VarChar(2000)
  logoObjectKey        String?                  @map("logo_object_key") @db.VarChar(512)
  website              String?                  @db.VarChar(320)
  contactEmail         String?                  @map("contact_email") @db.Citext
  contactPhone         String?                  @map("contact_phone") @db.VarChar(32)
  headquartersCity     String?                  @map("headquarters_city") @db.VarChar(80)
  headquartersState    String?                  @map("headquarters_state") @db.VarChar(80)
  operatingZones       String[]                 @default([]) @map("operating_zones")
  specialization       String?                  @db.VarChar(160)
  verificationStatus   AgencyVerificationStatus @default(UNVERIFIED) @map("verification_status")
  status               ProfileStatus            @default(ACTIVE)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy            String?                  @map("created_by") @db.Uuid
  updatedBy            String?                  @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([verificationStatus])
  @@map("agency_profiles")
}

model UserPlatformRole {
  id        String       @id @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      PlatformRole
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?      @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_platform_roles")
}

model UserPersona {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  persona   Persona
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, persona])
  @@index([userId])
  @@map("user_personas")
}

model AuditEvent {
  id             String   @id @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String   @db.VarChar(120)
  resourceType   String?  @map("resource_type") @db.VarChar(80)
  resourceId     String?  @map("resource_id") @db.VarChar(80)
  requestId      String?  @map("request_id") @db.VarChar(80)
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorUserId])
  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

model IdempotencyKey {
  id             String   @id @db.Uuid
  key            String   @db.VarChar(128)
  scope          String   @db.VarChar(64)
  userId         String?  @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  requestHash    String?  @map("request_hash") @db.VarChar(64)
  responseCode   Int?     @map("response_code")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([key, scope, userId, organizationId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model Project {
  id               String                @id @db.Uuid
  publicId         String                @unique @map("public_id") @db.VarChar(32)
  organizationId   String                @map("organization_id") @db.Uuid
  createdBy        String?               @map("created_by") @db.Uuid
  updatedBy        String?               @map("updated_by") @db.Uuid
  name             String                @db.VarChar(160)
  slug             String                @db.VarChar(180)
  description      String?               @db.VarChar(5000)
  projectType      ProjectType           @map("project_type")
  lifecycleStatus  ProjectLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  addressLine1     String?               @map("address_line1") @db.VarChar(200)
  addressLine2     String?               @map("address_line2") @db.VarChar(200)
  locality         String?               @db.VarChar(120)
  microMarket      String?               @map("micro_market") @db.VarChar(120)
  city             String?               @db.VarChar(80)
  state            String?               @db.VarChar(80)
  postalCode       String?               @map("postal_code") @db.VarChar(20)
  countryCode      String                @default("IN") @map("country_code") @db.VarChar(2)
  latitude         Decimal?              @db.Decimal(10, 7)
  longitude        Decimal?              @db.Decimal(10, 7)
  totalAreaSqft    Decimal?              @map("total_area_sqft") @db.Decimal(14, 2)
  totalUnits       Int?                  @map("total_units")
  startingPriceMinor BigInt?             @map("starting_price_minor")
  currency         String                @default("INR") @db.VarChar(3)
  possessionDate   DateTime?             @map("possession_date") @db.Date
  publishedAt      DateTime?             @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz(3)
  version          Int                   @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  properties   Property[]
  communities  Community[]
  matchedLeads Lead[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([lifecycleStatus])
  @@index([city])
  @@index([locality])
  @@index([microMarket])
  @@index([projectType])
  @@index([publishedAt])
  @@index([deletedAt])
  @@map("projects")
}

model Property {
  id                 String                     @id @db.Uuid
  publicId           String                     @unique @map("public_id") @db.VarChar(32)
  organizationId     String                     @map("organization_id") @db.Uuid
  projectId          String?                    @map("project_id") @db.Uuid
  createdBy          String?                    @map("created_by") @db.Uuid
  updatedBy          String?                    @map("updated_by") @db.Uuid
  title              String                     @db.VarChar(200)
  propertyType       PropertyType               @map("property_type")
  listingType        ListingType                @default(SALE) @map("listing_type")
  configuration      PropertyConfiguration?
  bedrooms           Int?
  bathrooms          Int?
  carpetAreaSqft     Decimal?                   @map("carpet_area_sqft") @db.Decimal(12, 2)
  builtUpAreaSqft    Decimal?                   @map("built_up_area_sqft") @db.Decimal(12, 2)
  plotAreaSqft       Decimal?                   @map("plot_area_sqft") @db.Decimal(12, 2)
  floorNumber        Int?                       @map("floor_number")
  totalFloors        Int?                       @map("total_floors")
  facing             String?                    @db.VarChar(40)
  priceMinor         BigInt                     @map("price_minor")
  currency           String                     @default("INR") @db.VarChar(3)
  availabilityStatus PropertyAvailabilityStatus @default(AVAILABLE) @map("availability_status")
  publicationStatus  PropertyPublicationStatus  @default(DRAFT) @map("publication_status")
  description        String?                    @db.VarChar(5000)
  addressLine1       String?                    @map("address_line1") @db.VarChar(200)
  addressLine2       String?                    @map("address_line2") @db.VarChar(200)
  locality           String?                    @db.VarChar(120)
  city               String?                    @db.VarChar(80)
  state              String?                    @db.VarChar(80)
  postalCode         String?                    @map("postal_code") @db.VarChar(20)
  countryCode        String                     @default("IN") @map("country_code") @db.VarChar(2)
  latitude           Decimal?                   @db.Decimal(10, 7)
  longitude          Decimal?                   @db.Decimal(10, 7)
  publishedAt        DateTime?                  @map("published_at") @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  version            Int                        @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  matchedLeads Lead[]

  @@index([organizationId])
  @@index([projectId])
  @@index([publicationStatus])
  @@index([availabilityStatus])
  @@index([city])
  @@index([locality])
  @@index([propertyType])
  @@index([configuration])
  @@index([bedrooms])
  @@index([priceMinor])
  @@index([publishedAt])
  @@index([deletedAt])
  @@map("properties")
}

model Community {
  id             String              @id @db.Uuid
  publicId       String              @unique @map("public_id") @db.VarChar(32)
  organizationId String              @map("organization_id") @db.Uuid
  projectId      String?             @map("project_id") @db.Uuid
  createdBy      String?             @map("created_by") @db.Uuid
  updatedBy      String?             @map("updated_by") @db.Uuid
  name           String              @db.VarChar(160)
  description    String?             @db.VarChar(2000)
  status         CommunityStatus     @default(ACTIVE)
  visibility     CommunityVisibility @default(PRIVATE)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(3)
  version        Int                 @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@map("communities")
}

model MediaAsset {
  id             String           @id @db.Uuid
  publicId       String           @unique @map("public_id") @db.VarChar(32)
  organizationId String           @map("organization_id") @db.Uuid
  entityType     CatalogEntityType @map("entity_type")
  entityId       String           @map("entity_id") @db.Uuid
  storageKey     String           @map("storage_key") @db.VarChar(512)
  mimeType       String           @map("mime_type") @db.VarChar(120)
  mediaType      MediaType        @map("media_type")
  fileSizeBytes  BigInt           @map("file_size_bytes")
  sortOrder      Int              @default(0) @map("sort_order")
  altText        String?          @map("alt_text") @db.VarChar(240)
  visibility     AssetVisibility  @default(PRIVATE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?          @map("created_by") @db.Uuid
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([visibility])
  @@index([deletedAt])
  @@map("media_assets")
}

model DocumentAsset {
  id             String            @id @db.Uuid
  publicId       String            @unique @map("public_id") @db.VarChar(32)
  organizationId String            @map("organization_id") @db.Uuid
  entityType     CatalogEntityType @map("entity_type")
  entityId       String            @map("entity_id") @db.Uuid
  storageKey     String            @map("storage_key") @db.VarChar(512)
  mimeType       String            @map("mime_type") @db.VarChar(120)
  documentType   String            @map("document_type") @db.VarChar(80)
  title          String            @db.VarChar(200)
  fileSizeBytes  BigInt            @map("file_size_bytes")
  visibility     AssetVisibility   @default(PRIVATE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?           @map("created_by") @db.Uuid
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([visibility])
  @@index([deletedAt])
  @@map("document_assets")
}

model ResourceAssignment {
  id             String                 @id @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  resourceType   ResourceAssignmentType @map("resource_type")
  resourceId     String                 @map("resource_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?                @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@map("resource_assignments")
}

model Requirement {
  id                 String                     @id @db.Uuid
  publicId           String                     @unique @map("public_id") @db.VarChar(32)
  ownerUserId        String                     @map("owner_user_id") @db.Uuid
  propertyType       PropertyType               @map("property_type")
  transactionType    RequirementTransactionType @map("transaction_type")
  configuration      PropertyConfiguration?
  bedrooms           Int?
  budgetMinMinor     BigInt?                    @map("budget_min_minor")
  budgetMaxMinor     BigInt?                    @map("budget_max_minor")
  currency           String                     @default("INR") @db.VarChar(3)
  city               String                     @db.VarChar(80)
  locality           String?                    @db.VarChar(120)
  microMarket        String?                    @map("micro_market") @db.VarChar(120)
  preferredProject   String?                    @map("preferred_project") @db.VarChar(160)
  purpose            RequirementPurpose         @default(END_USE)
  timeline           RequirementTimeline        @default(FLEXIBLE)
  vaastuRequired     Boolean                    @default(false) @map("vaastu_required")
  amenities          String[]                   @default([])
  notes              String?                    @db.VarChar(2000)
  status             RequirementStatus          @default(DRAFT)
  visibility         RequirementVisibility      @default(PRIVATE)
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?                    @map("created_by") @db.Uuid
  updatedBy          String?                    @map("updated_by") @db.Uuid

  owner User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  leads Lead[]

  @@index([ownerUserId])
  @@index([status])
  @@index([visibility])
  @@index([status, visibility])
  @@index([city])
  @@index([locality])
  @@index([microMarket])
  @@index([propertyType])
  @@index([transactionType])
  @@index([configuration])
  @@index([bedrooms])
  @@index([budgetMinMinor])
  @@index([budgetMaxMinor])
  @@index([createdAt])
  @@map("requirements")
}

model Lead {
  id                       String     @id @db.Uuid
  publicId                 String     @unique @map("public_id") @db.VarChar(32)
  requirementId            String     @map("requirement_id") @db.Uuid
  recipientOrganizationId  String     @map("recipient_organization_id") @db.Uuid
  recipientUserId          String?    @map("recipient_user_id") @db.Uuid
  matchedPropertyId        String?    @map("matched_property_id") @db.Uuid
  matchedProjectId         String?    @map("matched_project_id") @db.Uuid
  matchScore               Int        @map("match_score")
  matchedCriteria          Json       @map("matched_criteria")
  unmatchedCriteria        Json       @map("unmatched_criteria")
  matchExplanation         String     @map("match_explanation") @db.VarChar(1000)
  source                   LeadSource @default(REQUIREMENT_MARKETPLACE)
  status                   LeadStatus @default(NEW)
  priority                 LeadPriority @default(NORMAL)
  assignedAt               DateTime?  @map("assigned_at") @db.Timestamptz(3)
  firstViewedAt            DateTime?  @map("first_viewed_at") @db.Timestamptz(3)
  contactedAt              DateTime?  @map("contacted_at") @db.Timestamptz(3)
  version                  Int        @default(1)
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                String?    @map("created_by") @db.Uuid
  updatedBy                String?    @map("updated_by") @db.Uuid

  requirement           Requirement  @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  recipientOrganization Organization @relation(fields: [recipientOrganizationId], references: [id], onDelete: Restrict)
  recipientUser         User?        @relation("LeadAssignee", fields: [recipientUserId], references: [id], onDelete: SetNull)
  matchedProperty       Property?    @relation(fields: [matchedPropertyId], references: [id], onDelete: SetNull)
  matchedProject        Project?     @relation(fields: [matchedProjectId], references: [id], onDelete: SetNull)

  @@unique([requirementId, recipientOrganizationId])
  @@index([recipientOrganizationId])
  @@index([recipientUserId])
  @@index([status])
  @@index([source])
  @@index([matchScore])
  @@index([createdAt])
  @@index([matchedPropertyId])
  @@index([matchedProjectId])
  @@map("leads")
}

