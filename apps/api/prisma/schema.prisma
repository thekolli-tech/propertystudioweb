model VerificationCase {
  id                 String                   @id @db.Uuid
  publicId           String                   @unique @map("public_id") @db.VarChar(32)
  organizationId     String?                  @map("organization_id") @db.Uuid
  subjectType        VerificationSubjectType  @map("subject_type")
  subjectId          String                   @map("subject_id") @db.Uuid
  verificationType   VerificationSubjectType  @map("verification_type")
  status             VerificationCaseStatus   @default(DRAFT)
  reraNumber         String?                  @map("rera_number") @db.VarChar(64)
  declarationAccepted Boolean                 @default(false) @map("declaration_accepted")
  submittedByUserId  String?                  @map("submitted_by_user_id") @db.Uuid
  reviewedByUserId   String?                  @map("reviewed_by_user_id") @db.Uuid
  submittedAt        DateTime?                @map("submitted_at") @db.Timestamptz(3)
  reviewedAt         DateTime?                @map("reviewed_at") @db.Timestamptz(3)
  expiresAt          DateTime?                @map("expires_at") @db.Timestamptz(3)
  rejectionReason    String?                  @map("rejection_reason") @db.VarChar(1000)
  reviewerNotes      String?                  @map("reviewer_notes") @db.VarChar(2000)
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?                  @map("created_by") @db.Uuid
  updatedBy          String?                  @map("updated_by") @db.Uuid

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  submittedBy  User?         @relation("VerificationSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy   User?         @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  documents    VerificationDocument[]

  @@index([subjectType, subjectId, verificationType])
  @@index([organizationId])
  @@index([subjectType, subjectId])
  @@index([status])
  @@index([submittedAt])
  @@index([expiresAt])
  @@map("verification_cases")
}

model VerificationDocument {
  id                 String                      @id @db.Uuid
  publicId           String                      @unique @map("public_id") @db.VarChar(32)
  verificationCaseId String                      @map("verification_case_id") @db.Uuid
  documentAssetId    String                      @map("document_asset_id") @db.Uuid
  documentType       VerificationDocumentType    @map("document_type")
  status             VerificationDocumentStatus  @default(SUBMITTED)
  extractedReference String?                     @map("extracted_reference") @db.VarChar(160)
  reviewerNotes      String?                     @map("reviewer_notes") @db.VarChar(1000)
  uploadedByUserId   String                      @map("uploaded_by_user_id") @db.Uuid
  reviewedAt         DateTime?                   @map("reviewed_at") @db.Timestamptz(3)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)
  documentAsset    DocumentAsset    @relation(fields: [documentAssetId], references: [id], onDelete: Restrict)

  @@index([verificationCaseId])
  @@index([documentAssetId])
  @@index([status])
  @@map("verification_documents")
}

model Review {
  id                 String            @id @db.Uuid
  publicId           String            @unique @map("public_id") @db.VarChar(32)
  authorUserId       String            @map("author_user_id") @db.Uuid
  organizationId     String?           @map("organization_id") @db.Uuid
  subjectType        ReviewSubjectType @map("subject_type")
  subjectId          String            @map("subject_id") @db.Uuid
  title              String?           @db.VarChar(200)
  body               String            @db.VarChar(4000)
  status             ReviewStatus      @default(PENDING)
  overallRating      Int               @map("overall_rating")
  eligibilityBasis   String            @map("eligibility_basis") @db.VarChar(64)
  publishedAt        DateTime?         @map("published_at") @db.Timestamptz(3)
  moderatedAt        DateTime?         @map("moderated_at") @db.Timestamptz(3)
  moderatedByUserId  String?           @map("moderated_by_user_id") @db.Uuid
  moderatorNotes     String?           @map("moderator_notes") @db.VarChar(1000)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  author      User          @relation("ReviewAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  moderatedBy User?         @relation("ReviewModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  ratings     ReviewRating[]
  reports     ReviewReport[]

  @@unique([authorUserId, subjectType, subjectId])
  @@index([organizationId])
  @@index([subjectType, subjectId])
  @@index([status])
  @@index([publishedAt])
  @@map("reviews")
}

