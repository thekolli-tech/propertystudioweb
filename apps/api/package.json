{
  "name": "@property-studio/api",
  "version": "0.0.0",
  "private": true,
  "description": "Property Studio NestJS API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "11.1.17",
    "@nestjs/core": "11.1.17",
    "@nestjs/platform-express": "11.1.17",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@property-studio/contracts": "workspace:*",
    "@property-studio/permissions": "workspace:*",
    "@property-studio/public-id": "workspace:*",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.17",
    "@property-studio/tsconfig": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "pino-pretty": "^13.1.1",
    "prisma": "7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
