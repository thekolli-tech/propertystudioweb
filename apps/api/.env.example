# Property Studio V3 — local development environment
# Copy to apps/api/.env and apps/web/.env.local as needed.
# Never commit real secrets.

# --- Runtime ---
NODE_ENV=development

# --- Market defaults (India) ---
APP_MARKET=IN
APP_CURRENCY=INR
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en-IN

# --- API ---
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://property_studio:property_studio@localhost:5432/property_studio?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=property-studio
S3_FORCE_PATH_STYLE=true

# --- Rate limiting / proxy trust ---
# TRUST_PROXY=true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
PARTNER_RATE_LIMIT_WINDOW_MS=60000
PARTNER_RATE_LIMIT_MAX_REQUESTS=60
BODY_SIZE_LIMIT_BYTES=1048576
SESSION_TTL_SECONDS=1209600
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments — production forbids SANDBOX unless ALLOW_SANDBOX_PAYMENTS=true ---
PAYMENTS_PROVIDER=SANDBOX
ALLOW_SANDBOX_PAYMENTS=false
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
DEFAULT_LEAD_PURCHASE_PRICE_MINOR=50000

# --- Partner / integration secret encryption (optional until outbound webhooks) ---
# INTEGRATION_SECRETS_KEY=

