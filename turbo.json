{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "NODE_ENV",
    "APP_MARKET",
    "APP_CURRENCY",
    "APP_TIMEZONE",
    "APP_LOCALE",
    "API_HOST",
    "API_PORT",
    "API_PUBLIC_URL",
    "WEB_ORIGIN",
    "LOG_LEVEL",
    "DATABASE_URL",
    "REDIS_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_BUCKET",
    "S3_FORCE_PATH_STYLE",
    "RATE_LIMIT_WINDOW_MS",
    "RATE_LIMIT_MAX_REQUESTS",
    "AUTH_RATE_LIMIT_WINDOW_MS",
    "AUTH_RATE_LIMIT_MAX_REQUESTS",
    "PARTNER_RATE_LIMIT_WINDOW_MS",
    "PARTNER_RATE_LIMIT_MAX_REQUESTS",
    "WEBHOOK_REPLAY_TOLERANCE_SECONDS",
    "WEBHOOK_DELIVERY_TIMEOUT_MS",
    "INTEGRATION_SECRETS_KEY",
    "SESSION_TTL_SECONDS",
    "ARGON2_MEMORY_COST",
    "ARGON2_TIME_COST",
    "ARGON2_PARALLELISM",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_APP_URL",
    "API_INTERNAL_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
